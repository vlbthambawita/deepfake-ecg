# Bash options:
set -eu


# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if [ $# -lt 2 ] ; then
   echo >&2 "Usage: $0 output_directory number_of_ecgs"
   echo >&2 "Example: $0 DeepfakeECG 10000"
   exit 1
fi
DIRECTORY="$1"
NUMBER_OF_ECGs="$2"

# ====== Generator loop =====================================================
n=0
while [ ${n} -lt ${NUMBER_OF_ECGs} ] ; do
   a=$(( n / 10000 ))
   r=$(( n - 10000 * a ))
   b=$(( r / 100 ))
   r=$(( r - 100 * b ))
   c=$(( r ))

   subdirectory="$(printf "%d/%02d/%02d" "${a}" "${b}" "${c}")"
   mkdir -p "${DIRECTORY}/${subdirectory}"

   # Generate batch of 100 ECGs, if the first ECG is missing:
   firstECG="$(printf "${DIRECTORY}/${subdirectory}/ECG-%06d.csv.gz" "$((n + 1))")"
   if [ ! -e "${firstECG}" ] ; then
      ./generator-tool --type ECG12 --format csv --output "${DIRECTORY}/${subdirectory}/ECG-{number:06d}.csv.gz" --start-id "${n}" --number 100
   fi

   n=$(( n + 100 ))
done
